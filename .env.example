# Council Inventory System - Gmail SMTP settings
# IMPORTANT: SMTP_USER is the Gmail account that SENDS the report.
# The recipient is chosen by the admin in the Reports panel and is NOT stored here.
# For Gmail, use a Google App Password, NOT your normal Gmail password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-gmail@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=your-sending-gmail@gmail.com

# Optional
ADMIN_DEFAULT_PASSWORD=Admin@12345
